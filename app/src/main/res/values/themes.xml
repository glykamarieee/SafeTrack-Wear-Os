<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="safetrack_black">#000000</color>
    <color name="safetrack_icon_bg">#0E2A1E</color>

    <style name="Theme.SafeTrack" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@color/safetrack_black</item>
    </style>

    <style name="Theme.SafeTrack.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/safetrack_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SafeTrack</item>
    </style>
</resources>
